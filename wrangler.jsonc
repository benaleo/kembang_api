{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kembang-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "kv_namespaces": [
    { "binding": "AI_SESSIONS" }
  ]
}
