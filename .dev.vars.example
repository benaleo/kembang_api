SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: public origin used to build OAuth callback URLs behind proxies/dev tunnels.
# Local dev: http://localhost:8787
# Production: https://api-kembang.langganan-ku.my.id
API_PUBLIC_URL=
OMNIROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
# Wajib diisi: allowlist chat id Telegram. Kosong = bot menolak semua chat.
TELEGRAM_ALLOWED_CHAT_IDS=
# Secret webhook Telegram — set nilai yang sama saat registrasi webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL>&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=
INVOICE_SECRET_KEY=

# Shared secret untuk self-call internal (AI tools -> route admin).
# Generate: openssl rand -hex 32
# Kalau kosong, jalur internal mati total (fail closed) dan tool AI tidak jalan.
INTERNAL_API_TOKEN=

# Secret Vercel Deploy Hook untuk re-deploy manual kembang_web dari Pengaturan CMS.
VERCEL_DEPLOY_HOOK_URL=

# Geoapify (geocoding)
GEOAPIFY_API_KEY=

# Mapbox (directions matrix — delivery cost route distance)
MAPBOX_ACCESS_TOKEN=

# Swagger docs basic auth (jangan set di production = docs disabled)
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
